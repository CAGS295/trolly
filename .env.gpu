# Discrete RX 7600 is selected by HIP marketing name (default match: RX).
# Do not set HIP_VISIBLE_DEVICES=0 here: if the iGPU is index 0 that would
# hide the RX card. gpu_train_orchestrator bails unless an RX device is visible.
TROLLY_TRAIN_DEVICE=auto
TROLLY_TRAIN_GPU_MATCH=RX
LIBTORCH_USE_PYTORCH=1
LIBTORCH_BYPASS_VERSION_CHECK=1
